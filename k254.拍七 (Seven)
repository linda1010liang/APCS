#k254.拍七 (Seven)
def haveb(i,b): #檢查i裡是否出現b
    s=str(i)    #把i換成字串
    for a in s:
        if int(a)==b:
            return True
    return False
s,e,b,k=map(int,input().split())
p=0
for i in range(s,e+1):
    if i%b==0 or haveb(i,b):  
        p+=1
        if p==k:
            print(i)
            break
if p!=k:
    print("-1")

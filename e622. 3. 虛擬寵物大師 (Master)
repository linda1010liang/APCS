#e622. 3. 虛擬寵物大師 (Master)
n,s=map(int,input().split())
maxi=1
maxcp=0
for i in range(n):
    cp,iv=map(int,input().split())
    if 0<=iv<=29:
        cp+=s//1000*10
    elif 30<=iv<=39:
        cp+=s//1000*50
    elif 40<=iv<=45:
        cp+=s//1000*100
    if cp>maxcp:
        maxcp=cp
        maxi=i+1
print(maxi,maxcp)
